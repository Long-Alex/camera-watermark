#define name 相机水印
#define color pink
#define glyph camera
#include 'actions/calendar'
#include 'actions/documents'
#include 'actions/images'
#include 'actions/location'
#include 'actions/media'
#include 'actions/photos'
#include 'actions/text'
#include 'actions/web'

action 'calculateexpression' calculateExpression(text expression: 'Input'): number

comment('从照片或文件中选择图片，按拍摄信息生成水印，并将成品保存到照片图库。')
comment('Shortcuts generated by Shortcuts Playground.')

// 1. 先测量当前设备的渲染比例，后续以照片的实际像素尺寸回算水印。
comment('- 用 100 点测试图测量设备像素比例')
@probeHtml = "<!DOCTYPE html><html><head><meta charset=utf-8></head><body style='margin:0'>.</body></html>"
const probeRichText = getRichTextFromHTML(@probeHtml)
const probeSize = calculateExpression("100")
const probeImage = makeImageFromRichText(probeRichText, "100", probeSize)
const probePixelWidth = getImageDetail(probeImage, "Width")
const deviceScale = calculateExpression("rint({probePixelWidth} / 100)")

// 2. 同步资源。先创建父目录，再读本机版本；只有版本不同时才下载整个仓库。
comment('- 同步: 读取远端版本；本机版本不同时下载并覆盖资源包')
const remoteManifestFile = downloadURL("https://raw.githubusercontent.com/Long-Alex/camera-watermark/main/manifest.json", {"Cache-Control": "no-cache"})
const remoteManifestText = getText(remoteManifestFile)
const remoteManifest = getDictionary(remoteManifestText)
const remoteVersionValue = getValue(remoteManifest, "version")
const remoteVersion = getText(remoteVersionValue)
const createMirrorFolder = createFolder("camera-watermark")
@localVersion = "none"

comment('- 本地清单不存在时按版本不匹配处理')
const localManifestFile = getFile("camera-watermark/manifest.json", nil, false)
comment('- 如果没有本机版本号，后续同步条件会下载完整资源包')
if localManifestFile {
	const localManifestText = getText(localManifestFile)
	const localManifest = getDictionary(localManifestText)
	const localVersionValue = getValue(localManifest, "version")
	@localVersion = getText(localVersionValue)
}

comment('- 版本不同才下载 zip；下载禁用缓存以确保拿到最新文件')
if remoteVersion != @localVersion {
	const archive = downloadURL("https://github.com/Long-Alex/camera-watermark/archive/refs/heads/main.zip", {"Cache-Control": "no-cache"})
	const extractedProject = extractArchive(archive)
	const replaceMirror = saveFile("camera-watermark", extractedProject, true)
}

// 3. 读取项目数据，并在处理照片前一次性选择照片和水印设置。
comment('- 读取项目清单、文案与款式设置')
const manifestFile = getFile("camera-watermark/manifest.json", nil, true)
const manifestText = getText(manifestFile)
const manifest = getDictionary(manifestText)
const messagesFile = getFile("camera-watermark/messages.json", nil, true)
const messagesText = getText(messagesFile)
const messages = getDictionary(messagesText)
const prompts = getValue(messages, "prompts")
@sourcePrompt = getValue(prompts, "source")
@presetPrompt = getValue(prompts, "preset")
@stylePrompt = getValue(prompts, "style")
@logoPrompt = getValue(prompts, "logo")

comment('- 来源菜单从项目内的 vCard 读取联系人选项')
const sourceMenuFile = getFile("camera-watermark/menus/photo-source.vcf", nil, true)
const sourceMenuNamed = setName(sourceMenuFile, "photo-source.vcf")
comment('ALLOW_VCARD: The project photo source menu is intentionally stored as a vCard.')
const sourceChoice = chooseFromList(sourceMenuNamed.contact, "{@sourcePrompt}")
@photos = list()

comment('- 从相册选择多张照片')
if sourceChoice['Name'] == "相册选择" {
	@photos = selectPhotos(true)
} else {
	comment('- 文件选择后先转换为图像；拍摄选项直接打开相机')
	if sourceChoice['Name'] == "文件选择" {
		const selectedFiles = selectFile(true)
		@photos = getImages(selectedFiles)
	} else {
		@photos = takePhoto()
	}
}

comment('- 先选择水印款式；清单里的每个 id 对应一个 preset 文件')
const presetOptions = getValue(manifest, "presets")
const presetChoice = chooseFromList(presetOptions, "{@presetPrompt}")
const presetId = getText(presetChoice)
const presetFile = getFile("camera-watermark/presets/{presetId}.json", nil, true)
const presetText = getText(presetFile)
@preset = getDictionary(presetText)
const presetMetadata = getValue(@preset, "metadata")
const designShort = getValue(presetMetadata, "designShort")
const bandHeightsByVariant = getValue(presetMetadata, "bandDpByVariant")
const bandHeightGps = getValue(bandHeightsByVariant, "layout")
const bandHeightNoGps = getValue(bandHeightsByVariant, "layout_loc_off")

comment('- 选择配色；所选配色只对本次批量处理生效')
const styleOrder = getValue(@preset, "styleOrder")
const styleChoice = chooseFromList(styleOrder, "{@stylePrompt}")
const styleId = getText(styleChoice)
const styles = getValue(@preset, "styles")
const selectedStyle = getValue(styles, "{styleId}")
const foregroundStart = getValue(selectedStyle, "foregroundStart")
const foregroundEnd = getValue(selectedStyle, "foregroundEnd")
const backgroundColor = getValue(selectedStyle, "bgColor")

comment('- 选择品牌标识；可选 SVG 文件会内嵌到水印模板')
const logoFolder = getFile("camera-watermark/assets/logo", nil, true)
const logoFiles = getFolderContents(logoFolder, false)
const logoChoice = chooseFromList(logoFiles, "{@logoPrompt}")
const logoSvg = getText(logoChoice)

// 5. 模板只读一次；每张照片使用相同设置，分别读取自己的 EXIF 与定位信息。
comment('- 读取 HTML 模板、渲染代码和合成方式')
const htmlFile = getFile("camera-watermark/index.html.txt", nil, true)
const htmlTemplate = getText(htmlFile)
const rendererFile = getFile("camera-watermark/core/bundle.js", nil, true)
const rendererCode = getText(rendererFile)
const compose = getValue(@preset, "compose")
const composeModeValue = getValue(compose, "mode")
const composeMode = getText(composeModeValue)
const stitchSettings = getValue(compose, "stitch")
		const stitchDirectionValue = getValue(stitchSettings, "direction")
		const stitchDirection = getText(stitchDirectionValue)
		const stitchSpacing = getValue(stitchSettings, "spacing")
		const stitchSpacingNumber = calculateExpression("{stitchSpacing}")
comment('- 没有可处理的照片时给出说明并结束')
if !@photos {
	alert("没有选择到照片。请重新运行并选择至少一张图片。", "相机水印")
	stop()
} else {
	comment('- 逐张读取照片信息、渲染水印、按款式设置合成')
	for photo in @photos {
		const metadata = getImageDetail(@photo, "Metadata Dictionary")
		@cameraModel = getImageDetail(@photo, "Camera Model")
		const dateTaken = getImageDetail(@photo, "Date Taken")
		const formattedDate = formatDate(dateTaken, "Custom", "yyyy-MM-dd'T'HH:mm:ss")
		@photoWidth = getImageDetail(@photo, "Width")
		@photoHeight = getImageDetail(@photo, "Height")
		const photoShortEdge = calculateExpression("min({@photoWidth}, {@photoHeight})")
		const location = getImageDetail(@photo, "Location")
		@latitude = getLocationDetail(location, "Latitude")
		@longitude = getLocationDetail(location, "Longitude")
		@bandHeightDesign = bandHeightNoGps
		comment('- Both latitude and longitude come from the photo location')
		if @latitude && @longitude {
			@bandHeightDesign = bandHeightGps
		}
		const focalLength = getValue(metadata, '{Exif}.FocalLength')
		const focalLength35mm = getValue(metadata, '{Exif}.FocalLenIn35mmFilm')
		const aperture = getValue(metadata, '{Exif}.FNumber')
		const exposure = getValue(metadata, '{Exif}.ExposureTime')
		const iso = getValue(metadata, '{Exif}.ISOSpeedRatings')
		const unit = calculateExpression("{photoShortEdge} / {deviceScale} / {designShort}")
		const renderWidth = calculateExpression("rint({@photoWidth} / {deviceScale})")
		const renderHeight = calculateExpression("{@bandHeightDesign} * {unit}")

		// 模板中的运行时字段都是小块替换；CONFIG 保持 preset 原始 JSON。
		@page = replaceText("@@CONFIG@@", "{presetText}", htmlTemplate)
		@page = replaceText("@@UNIT@@", "{unit}", @page)
		@page = replaceText("@@MODEL@@", "{@cameraModel}", @page)
		@page = replaceText("@@TIME@@", "{formattedDate}", @page)
		@page = replaceText("@@FOCAL@@", "{focalLength35mm}", @page)
		@page = replaceText("@@FOCAL_ACTUAL@@", "{focalLength}", @page)
		@page = replaceText("@@APERTURE@@", "{aperture}", @page)
		@page = replaceText("@@SPEED@@", "{exposure}", @page)
		@page = replaceText("@@ISO@@", "{iso}", @page)
		@page = replaceText("@@LAT@@", "{@latitude}", @page)
		@page = replaceText("@@LON@@", "{@longitude}", @page)
		@page = replaceText("@@FOREGROUND_START@@", "{foregroundStart}", @page)
		@page = replaceText("@@FOREGROUND_END@@", "{foregroundEnd}", @page)
		@page = replaceText("@@BG_COLOR@@", "{backgroundColor}", @page)
		@page = replaceText("@@BG_IMAGE@@", "", @page)
		@page = replaceText("@@LOGO@@", "{logoSvg}", @page)
		@page = replaceText("@@CORE_JS@@", "{rendererCode}", @page)
		const richWatermark = getRichTextFromHTML(@page)
		const watermarkAtRenderSize = makeImageFromRichText(richWatermark, "{renderWidth}", renderHeight)
		const watermark = resizeImageByLongestEdge(watermarkAtRenderSize, "{@photoWidth}")

		comment('- 按 preset 固定的合成模式处理，不在运行时让用户猜选项')
		if composeMode == "overlay" {
			const overlaySettings = getValue(compose, "overlay")
			const overlayWidthDesign = getValue(overlaySettings, "width")
			const overlayHeightDesign = getValue(overlaySettings, "height")
			const overlayWidth = calculateExpression("{overlayWidthDesign} * {unit}")
			const overlayHeight = calculateExpression("{overlayHeightDesign} * {unit}")
			const overlayWidthText = getText(overlayWidth)
			const overlayHeightText = getText(overlayHeight)
			const overlayRotationValue = getValue(overlaySettings, "rotation")
			const overlayRotation = getText(overlayRotationValue)
			const overlayOpacityValue = getValue(overlaySettings, "opacity")
			const overlayOpacity = getText(overlayOpacityValue)
			const anchorValue = getValue(overlaySettings, "anchor")
			const anchor = getText(anchorValue)
			@composedImage = customImageOverlay(@photo, watermark, overlayWidthText, overlayHeightText, overlayRotation, overlayOpacity, anchor)
		} else {
			const imagesToJoin = list("{@photo}", "{watermark}")
			comment('- 网格布局')
			if stitchDirection == "In a Grid" {
				@composedImage = combineImages(imagesToJoin, "In a Grid", stitchSpacingNumber)
			} else {
				@composedImage = combineImages(imagesToJoin, "Vertically", stitchSpacingNumber)
			}
		}

		comment('- 每张照片合成后立即保存，避免依赖 Repeat 汇总返回值')
		savePhoto(@composedImage)
	}

	// 6. 全部照片保存完成后再通知用户。
	showNotification("照片水印已完成，并保存到照片图库。", "相机水印", false)
}
