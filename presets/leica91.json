                            {
                              "type": "TextView",
                              "id": "time",
                              "layout_gravity": "left|center_vertical",
                              "margin_left": "0dp",
                              "margin_top": "0dp",
                              "text": "@time=@wm_time_HH_mm",
                              "font_ref": "f3",
                              "childViews": []
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
