                  "gravity": "right|center_vertical",
                  "margin_left": "-80dp",
                  "margin_top": "-44dp",
                  "childViews": [
                    {
                      "type": "ImageView",
                      "id": "logo",
                      "layout_gravity": "right|center_vertical",
                      "margin_left": "0dp",
                      "margin_top": "0dp",
                      "display_height": "60dp",
                      "display_width": "0dp",
                      "path": "pathType=direct;path=logo",
                      "max_width": 0,
                      "childViews": []
                    }
                  ]
                },
                {
                  "type": "Layout",
                  "id": "right_bottom_group",
                  "orientation": "horizontal",
                  "layout_width": "match_parent",
                  "layout_height": "wrap_content",
                  "gravity": "right",
                  "margin_left": "0dp",
                  "margin_top": "120.5dp",
                  "childViews": [
                    {
                      "type": "Layout",
                      "id": "location_layout",
                      "optional": true,
                      "setting_optional_type": "type_location",
                      "orientation": "horizontal",
                      "layout_width": "wrap_content",
                      "layout_height": "55dp",
                      "margin_left": "0dp",
                      "gravity": "center_horizontal",
                      "childViews": [
                        {
                          "type": "TextView",
                          "id": "location",
                          "layout_gravity": "center",
                          "text": "@location=location_latlng_switch;@locationLimit=0.8;@LOC=oo",
                          "font_ref": "f3",
                          "childViews": []
                        }
                      ]
                    },
                    {
                      "type": "Layout",
                      "id": "exif_group",
                      "orientation": "vertical",
                      "layout_width": "wrap_content",
                      "layout_height": "58dp",
                      "gravity": "right",
                      "margin_left": "-80dp",
                      "margin_top": "2dp",
                      "childViews": [
                        {
                          "type": "TextView",
                          "id": "exif_line1",
                          "margin_top": "-1dp",
                          "layout_gravity": "right|center_vertical",
                          "text": "@exif=@{focal}mm  ISO @{iso}",
                          "font_ref": "f3",
                          "childViews": []
                        },
                        {
                          "type": "TextView",
                          "id": "exif_line2",
                          "layout_gravity": "right|center_vertical",
                          "text": "@exif=ƒ/@{aperture}  @{speed}s",
                          "font_ref": "f3",
                          "childViews": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
