{
  "version": "3",
  "metadata": {
    "id": "leica91",
    "designShort": 1080,
    "bandDpByVariant": {
      "center_top": 180.5
    },
    "position": "in",
    "source": "xiaomi apk leica/91 config.json"
  },
  "type": {
    "白色": "white",
    "深色": "dark"
  },
  "styles": {
    "white": {
      "foreground-start": "#FFFFFF",
      "foreground-end": "#FFFFFF",
      "foreground-stop": "30%",
      "foreground-direction": "90deg",
      "line-opacity": 0.5,
      "background-color": "transparent"
    },
    "dark": {
      "foreground-start": "#1D1D1F",
      "foreground-end": "#1D1D1F",
      "foreground-stop": "30%",
      "foreground-direction": "90deg",
      "line-opacity": 0.4,
      "background-color": "transparent"
    }
  },
  "compose": {
    "mode": "overlay",
    "overlay": {
      "anchor": "Center",
      "width": "photo",
      "height": 180.5,
      "rotation": 0,
      "opacityPercent": 100
    },
    "stitch": {
      "direction": "Vertically",
      "spacing": 0
    }
  },
  "fallback": {
    "note": "识别不到时的兜底值；date 支持 \"now\"（用渲染时刻，截图/无 EXIF 日期时）",
    "model": "iPhone 18 Pro Max",
    "date": "now",
    "focal": 24,
    "aperture": 1.8,
    "speed": 0.0166666667,
    "iso": 100
  },
