{
  "version": "1",
  "metadata": {
    "id": "leica",
    "designShort": 1080,
    "bandDp": 162,
    "modelDefault": "iPhone",
    "exifFallback": {
      "focal": 24,
      "aperture": 1.8,
      "speed": 0.016666667,
      "iso": 100
    },
    "bandDpByVariant": {
      "layout": 162,
      "layout_loc_off": 162
    }
  },
  "compose": {
    "mode": "stitch",
    "stitch": {
      "direction": "Vertically",
      "spacing": 0
    },
    "overlay": {
      "anchor": "Bottom Right",
      "width": 1080,
      "height": 160,
      "rotation": 0,
      "opacity": 100
    }
  },
  "styles": {
    "light": {
      "foregroundStart": "#000000",
      "foregroundEnd": "#000000",
      "bgColor": "#FFFFFF"
    },
    "dark": {
      "foregroundStart": "#FFFFFF",
      "foregroundEnd": "#FFFFFF",
      "bgColor": "#141414"
    },
    "gold": {
      "foregroundStart": "#7F591E",
      "foregroundEnd": "#B69332",
      "bgColor": "#1D1D1F"
    }
  },
  "layout_group": [
    {
      "layout": [
        {
          "type": "row",
          "id": "bottom_layout",
          "width": "100%",
          "height": "auto",
          "align-items": "center",
          "background-color": "#FFFFFF",
          "padding": {
            "top": 40,
            "bottom": 40,
            "left": 48,
            "right": 48
          },
          "children": [
            {
              "type": "column",
              "id": "left",
              "children": [
                {
                  "type": "text",
                  "id": "model",
                  "font": "f1",
                  "text": "@{model}"
                },
                {
                  "type": "text",
                  "id": "time",
                  "font": "f2",
                  "margin-top": 10,
                  "text": "@wm_time_yyyy.MM.dd HH:mm"
                }
              ],
              "flex": "none"
            },
            {
              "type": "row",
              "id": "right",
              "justify-content": "flex-end",
              "align-items": "center",
              "children": [
                {
                  "type": "image",
                  "id": "logo",
                  "src": "logo",
                  "height": 64,
                  "optional": true
                },
                {
                  "type": "divider",
                  "id": "sep",
                  "width": 2,
                  "height": 64,
                  "margin-left": 24
                },
                {
                  "type": "column",
                  "id": "exif_column",
                  "margin-left": 24,
                  "children": [
                    {
                      "type": "text",
                      "id": "exif",
                      "font": "f3",
                      "text-align": "right",
                      "text": "@{focal}mm  ƒ/@{aperture}  @{speed}s  ISO@{iso}"
                    },
                    {
                      "type": "text",
                      "id": "location",
                      "font": "f2",
                      "margin-top": 10,
                      "text": "location_latlng"
                    }
                  ]
                }
              ],
              "flex": "1"
            }
          ]
        }
      ]
    },
    {
      "layout_loc_off": [
        {
          "type": "row",
          "id": "bottom_layout",
          "width": "100%",
          "height": "auto",
          "align-items": "center",
          "background-color": "#FFFFFF",
          "padding": {
            "top": 40,
            "bottom": 40,
            "left": 48,
            "right": 48
          },
          "children": [
            {
              "type": "column",
              "id": "left",
              "children": [
                {
                  "type": "text",
                  "id": "model",
                  "font": "f1",
                  "text": "@{model}"
                },
                {
                  "type": "text",
                  "id": "time",
                  "font": "f2",
                  "margin-top": 10,
                  "text": "@wm_time_yyyy.MM.dd HH:mm"
                }
              ],
              "flex": "none"
            },
            {
              "type": "row",
              "id": "right",
              "justify-content": "flex-end",
              "align-items": "center",
              "children": [
                {
                  "type": "image",
                  "id": "logo",
                  "src": "logo",
                  "height": 64,
                  "optional": true
                },
                {
                  "type": "divider",
                  "id": "sep",
                  "width": 2,
                  "height": 64,
                  "margin-left": 24
                },
                {
                  "type": "column",
                  "id": "exif_column",
                  "margin-left": 24,
                  "children": [
                    {
                      "type": "text",
                      "id": "exif",
                      "font": "f3",
                      "text-align": "right",
                      "text": "@{focal}mm  ƒ/@{aperture}  @{speed}s  ISO@{iso}"
                    }
                  ]
                }
              ],
              "flex": "1"
            }
          ]
        }
      ]
    }
  ],
  "fonts": {
    "f1": {
      "font-size": 30.6,
      "font-weight": 501,
      "line-height": 42
    },
    "f2": {
      "font-size": 22,
      "font-weight": 451,
      "line-height": 30,
      "letter-spacing": "0.083em"
    },
    "f3": {
      "font-size": 30,
      "font-weight": 501,
      "line-height": 41
    }
  },
  "styleOrder": [
    "light",
    "dark",
    "gold"
  ]
}
