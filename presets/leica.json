{
  "version": "2",
  "metadata": {
    "id": "leica",
    "designShort": 1080,
    "bandDp": 159.8,
    "bandDpByVariant": {
      "layout": 159.8,
      "layout_loc_off": 159.0
    },
    "designFont": {
      "ascent": 1.044,
      "descent": 0.282,
      "note": "MiSans VF hhea 1044/-282 per 1000upem；行高 = (ascent + descent) × size"
    },
    "weightMap": {
      "note": "MiSans wght → iOS 系统字体(SF Pro)等效字重：按竖笔画中位宽实测对齐（_local/font_study.py）",
      "451": 550,
      "501": 620
    }
  },
  "compose": {
    "mode": "stitch",
    "stitch": {
      "direction": "Vertically",
      "spacing": 0
    },
    "overlay": {
      "anchor": "Bottom Right",
      "width": 1080,
      "height": 160,
      "rotation": 0,
      "opacity": 100
    }
  },
  "fallback": {
    "note": "识别不到时用的兜底值（截图/无 EXIF/无机型）",
    "model": "iPhone 18 Pro Max",
    "focal": 24,
    "aperture": 1.8,
    "speed": 0.0166666667,
    "iso": 100
  },
  "appearance": {
    "foreground-start": "#000000",
    "foreground-end": "#000000",
    "foreground-stop": "30%",
    "foreground-direction": "90deg",
    "line-opacity": 0.3,
    "background-color": "#FFFFFF"
  },
  "layout_group": [
    {
      "layout": [
        {
          "type": "row",
          "id": "bottom_layout",
          "width": "100%",
          "height": "auto",
          "align-items": "center",
          "background-color": "var(--watermark-bg)",
          "padding": {
            "top": 40,
            "bottom": 40,
            "left": 48,
            "right": 48
          },
          "children": [
            {
              "type": "column",
              "id": "left_bottom_layout",
              "flex": "none",
              "children": [
                {
                  "type": "text",
                  "id": "model",
                  "font": "f1",
                  "text": "@{model}"
                },
                {
                  "type": "text",
                  "id": "time",
                  "font": "f2",
                  "text": "@wm_time_yyyy_MM_dd_HH_mm",
                  "margin-top": 10
                }
              ]
            },
            {
              "type": "row",
              "id": "right_bottom_group",
              "flex": "1",
              "min-width": 0,
              "justify-content": "flex-end",
              "align-items": "center",
              "children": [
                {
                  "type": "image",
                  "id": "logo",
                  "src": "logo",
                  "height": 64,
                  "optional": true
                },
                {
                  "type": "divider",
                  "id": "line_layout",
                  "width": 2,
                  "height": 64,
                  "margin-left": 24
                },
                {
                  "type": "column",
                  "id": "exif_location_layout",
                  "margin-left": 24,
                  "align-items": "flex-start",
                  "children": [
                    {
                      "type": "text",
                      "id": "exif",
                      "font": "f3",
                      "text": "@{focal}mm  ƒ/@{aperture}  @{speed}s  ISO@{iso}",
                      "text-align": "right"
                    },
                    {
                      "type": "text",
                      "id": "location",
                      "font": "f2",
                      "text": "location_latlng",
                      "margin-top": 10
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "layout_loc_off": [
        {
          "type": "row",
          "id": "bottom_layout",
          "width": "100%",
          "height": "auto",
          "align-items": "center",
          "background-color": "var(--watermark-bg)",
          "padding": {
            "top": 40,
            "bottom": 40,
            "left": 48,
            "right": 48
          },
          "children": [
            {
              "type": "column",
              "id": "left_bottom_layout",
              "flex": "none",
              "children": [
                {
                  "type": "text",
                  "id": "model",
                  "font": "f1",
                  "text": "@{model}"
                }
              ]
            },
            {
              "type": "row",
              "id": "right_bottom_group",
              "flex": "1",
              "min-width": 0,
              "justify-content": "flex-end",
              "align-items": "center",
              "children": [
                {
                  "type": "image",
                  "id": "logo",
                  "src": "logo",
                  "height": 64,
                  "optional": true
                },
                {
                  "type": "divider",
                  "id": "line_layout",
                  "width": 2,
                  "height": 64,
                  "margin-left": 24
                },
                {
                  "type": "column",
                  "id": "exif_location_layout",
                  "margin-left": 24,
                  "align-items": "flex-start",
                  "children": [
                    {
                      "type": "text",
                      "id": "exif",
                      "font": "f3",
                      "text": "@{focal}mm  ƒ/@{aperture}  @{speed}s  ISO@{iso}",
                      "text-align": "right"
                    },
                    {
                      "type": "text",
                      "id": "time",
                      "font": "f2",
                      "text": "@wm_time_yyyy_MM_dd_HH_mm",
                      "margin-top": 10
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "fonts": {
    "f1": {
      "font-size": 30.6,
      "font-weight": 620,
      "line-height": 40.6,
      "font-family": "-apple-system,BlinkMacSystemFont,Helvetica Neue,sans-serif",
      "design-weight": 501
    },
    "f2": {
      "font-size": 22,
      "font-weight": 550,
      "line-height": 29.2,
      "letter-spacing": "0.083em",
      "opacity": 0.5,
      "font-family": "-apple-system,BlinkMacSystemFont,Helvetica Neue,sans-serif",
      "design-weight": 451
    },
    "f3": {
      "font-size": 30,
      "font-weight": 620,
      "line-height": 39.8,
      "font-family": "-apple-system,BlinkMacSystemFont,Helvetica Neue,sans-serif",
      "design-weight": 501
    }
  }
}
