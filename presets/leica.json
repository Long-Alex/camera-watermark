{
  "version": "2",
  "metadata": {
    "id": "leica",
    "designShort": 1080,
    "bandDpByVariant": {
      "layout": 159.8,
      "layout_loc_off": 159.0
    }
  },
  "type": {
    "浅色": "light",
    "深色": "dark",
    "金色": "rose",
    "红色": "red"
  },
  "styles": {
    "light": {
      "foreground-start": "#000000",
      "foreground-end": "#000000",
      "foreground-stop": "30%",
      "foreground-direction": "90deg",
      "line-opacity": 0.3,
      "background-color": "#FFFFFF"
    },
    "dark": {
      "foreground-start": "#FFFFFF",
      "foreground-end": "#FFFFFF",
      "foreground-stop": "30%",
      "foreground-direction": "90deg",
      "line-opacity": 0.7,
      "background-color": "#141414"
    },
    "rose": {
      "foreground-start": "#FDC9AE",
      "foreground-end": "#F5E3D9",
      "foreground-stop": "30%",
      "foreground-direction": "45deg",
      "line-opacity": 0.7,
      "background-color": "#1D1D1F"
    },
    "red": {
      "foreground-start": "#FFFFFF",
      "foreground-end": "#FFFFFF",
      "foreground-stop": "30%",
      "foreground-direction": "90deg",
      "line-opacity": 0.6,
      "background-image": "red",
      "background-fit": "cover"
    }
  },
  "compose": {
    "mode": "stitch",
    "stitch": {
      "direction": "Vertically",
      "spacing": 0
    },
    "overlay": {
      "anchor": "Bottom Right",
      "width": 1080,
      "height": 160,
      "rotation": 0,
      "opacityPercent": 100
    }
  },
  "fallback": {
    "note": "识别不到时的兜底值；date 支持 \"now\"（用渲染时刻，截图/无 EXIF 日期时）",
    "model": "iPhone 18 Pro Max",
    "date": "now",
    "focal": 24,
    "aperture": 1.8,
    "speed": 0.0166666667,
    "iso": 100
  },
  "layout_group": [
    {
      "layout": [
        {
          "type": "row",
          "id": "bottom_layout",
          "width": "100%",
          "height": "auto",
          "align-items": "center",
          "padding": {
            "top": 40,
            "bottom": 40,
            "left": 48,
            "right": 48
          },
          "children": [
            {
              "type": "column",
              "id": "left_bottom_layout",
              "flex": "none",
              "children": [
